{
    "compilerOptions": {
        "moduleResolution": "nodenext",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "target": "esnext",
        "module": "nodenext",
        "types": ["node"],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "paths": {
            "@components/": ["./src/components/"],
            "@classes/": ["./src/classes/"]
        }
    },
    "include": [
        "src//*.ts",
        "src//.tsx",
    ]
}